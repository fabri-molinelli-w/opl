# Copiar a .env y completar. NUNCA commitear .env

# --- PostgreSQL ---
POSTGRES_USER=opl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opl
DATABASE_URL=postgres://opl:change-me@postgres:5432/opl?sslmode=disable

# --- Backend ---
HTTP_PORT=8080
# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres.
JWT_SECRET=change-me-with-at-least-32-characters-long
JWT_TTL=8h
HEALTHCHECK_WORKERS=10
HEALTHCHECK_FAILS_TO_INCIDENT=3
DEPLOY_WEBHOOK_TOKEN=change-me
ADMIN_EMAIL=admin@opl.local
ADMIN_PASSWORD=change-me

# --- Comunicación backend <-> ai-service ---
# Local (make run-ai): http://localhost:8000. Si se deja vacío, el chat responde 503.
AI_SERVICE_URL=http://localhost:8000
# Generar con: openssl rand -hex 32
AI_INTERNAL_TOKEN=change-me
# URL con la que el ai-service llama al backend (solo GET, con el JWT del usuario)
BACKEND_URL=http://localhost:8080

# --- OPSBot: cualquier LLM con API compatible con OpenAI y soporte de tools ---
# Ejemplos (verificar que el modelo siga disponible):
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=change-me
LLM_MODEL=elegir-modelo-con-tools
# Embeddings locales (fastembed/ONNX). Se descarga una vez (~220 MB) en la primera consulta.
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=chroma_data


# --- Herramientas de desarrollo (MCP) ---
GITHUB_PAT=
