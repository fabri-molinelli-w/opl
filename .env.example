# Copiar a .env y completar. NUNCA commitear .env

# --- PostgreSQL ---
POSTGRES_USER=opl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opl
DATABASE_URL=postgres://opl:change-me@postgres:5432/opl?sslmode=disable

# --- Backend ---
HTTP_PORT=8080
JWT_SECRET=change-me-long-random
JWT_TTL=8h
HEALTHCHECK_WORKERS=10
HEALTHCHECK_FAILS_TO_INCIDENT=3
DEPLOY_WEBHOOK_TOKEN=change-me
ADMIN_EMAIL=admin@opl.local
ADMIN_PASSWORD=change-me

# --- Comunicación backend <-> ai-service ---
AI_SERVICE_URL=http://ai-service:8000
AI_INTERNAL_TOKEN=change-me

# --- OPLBot (LLM vía OpenCode Zen, endpoint compatible OpenAI) ---
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=change-me
LLM_MODEL=elegir-modelo-gratuito-vigente
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small


# --- Herramientas de desarrollo (MCP) ---
GITHUB_PAT=
